---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryCard from '../components/GalleryCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SmartImage from '../components/SmartImage.astro';
import Icon from '../components/Icon.astro';
import { getBootstrap } from '../lib/api';
import { formatDate } from '../lib/format';
import { copyReader } from '../lib/site';
import type { Photo } from '../types';

const query = (Astro.url.searchParams.get('q') || '').trim();
const { site, page: searchPage } = await getBootstrap({ route: 'search', q: query });
if (searchPage.kind !== 'search') throw new Error('unexpected bootstrap payload for /search');
const { site: siteSettings } = site.settings;
const copy = copyReader(site.settings);
// Search failures are real errors now: a broken backend must not render an
// empty 200 result page. The bootstrap payload is the only request (R1).
const results = searchPage;
const total =
  results.articles.length +
  (results.projects?.length || 0) +
  results.galleries.length +
  (results.photos?.length || 0);
const photoMeta = (photo: Photo) =>
  [photo.location, photo.camera, photo.taken_at?.slice(0, 10)]
    .filter(Boolean)
    .join(' / ');
---
<BaseLayout
  site={site}
  title={query ? `搜索「${query}」` : copy('search_title', '搜索')}
  description={`${copy('search_lead', '在标题、正文、器材与项目信息之间查找。')} ${siteSettings.site_title}`}
  noindex={!query}
>
  <section class="container page-hero">
    <span class="eyebrow">{copy('search_eyebrow', '// SEARCH')}</span>
    <h1>{copy('search_title', '搜索')}</h1>
    <p>{copy('search_lead', '在标题、正文、器材与项目信息之间查找。')}</p>
    <form class="search-form" action="/search" method="get" role="search">
      <Icon name="search" size={15} />
      <input
        name="q"
        type="search"
        value={query}
        placeholder={copy('search_placeholder', '输入关键词')}
        aria-label="搜索全站"
        autofocus={!query}
      />
      <button class="btn btn--small" type="submit">{copy('cta_search', '搜索')}</button>
    </form>
    {
      query && (
        <div class="page-hero__meta">
          <span>「{query}」</span>
          <span>/</span>
          <span>{String(total).padStart(2, '0')} RESULTS</span>
        </div>
      )
    }
  </section>

  <div class="container">
    {
      !query ? (
        <div class="empty-state">
          <span class="empty-mark">⌕</span>
          <h2>{copy('search_placeholder', '输入关键词')}</h2>
          <p>{copy('search_suggestions', '试试标题、正文、地点、器材、年份或角色。')}</p>
          <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap">
            <a class="btn btn--ghost" href="/photos">{copy('photos_title', '影像')}</a>
            <a class="btn btn--ghost" href="/projects">{copy('projects_title', '项目')}</a>
            <a class="btn btn--ghost" href="/archive">{copy('texts_title', '文字')}</a>
          </div>
        </div>
      ) : total === 0 ? (
        <div class="empty-state">
          <span class="empty-mark">—</span>
          <h2>{copy('search_empty', '没有找到匹配的内容。')}</h2>
          <p>{copy('search_suggestions', '试试标题、正文、地点、器材、年份或角色。')}</p>
          <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap">
            <a class="btn btn--ghost" href="/photos">{copy('photos_title', '影像')}</a>
            <a class="btn btn--ghost" href="/projects">{copy('projects_title', '项目')}</a>
            <a class="btn btn--ghost" href="/archive">{copy('texts_title', '文字')}</a>
          </div>
        </div>
      ) : (
        <>
          {(results.projects?.length || 0) > 0 && (
            <section class="result-group">
              <h2>
                {copy('search_projects', '项目')} <span>{String(results.projects.length).padStart(2, '0')}</span>
              </h2>
              <div class="project-grid project-grid--compact">
                {results.projects.map((project, index) => (
                  <ProjectCard project={project} index={index} />
                ))}
              </div>
            </section>
          )}

          {(results.photos?.length || 0) > 0 && (
            <section class="result-group">
              <h2>
                {copy('search_photo_items', '照片')} <span>{String(results.photos.length).padStart(2, '0')}</span>
              </h2>
              <div class="search-photo-grid">
                {results.photos.map((photo) => (
                  <a class="search-photo" href={photo.gallery ? photo.gallery.url : photo.url}>
                    <span class="search-photo__thumb">
                      <SmartImage image={photo.image} src={photo.url} alt={photo.alt} scene="thumb" />
                    </span>
                    <span class="search-photo__body">
                      <strong>{photo.title || photo.gallery?.title || '照片'}</strong>
                      <span>{photoMeta(photo) || photo.gallery?.title || ''}</span>
                    </span>
                  </a>
                ))}
              </div>
            </section>
          )}

          {results.galleries.length > 0 && (
            <section class="result-group">
              <h2>
                {copy('search_photos', '影像')} <span>{String(results.galleries.length).padStart(2, '0')}</span>
              </h2>
              <div class="gallery-grid">
                {results.galleries.map((gallery, index) => (
                  <GalleryCard gallery={gallery} label={siteSettings.site_title} index={index + 1} />
                ))}
              </div>
            </section>
          )}

          {results.articles.length > 0 && (
            <section class="result-group">
              <h2>
                {copy('search_texts', '文字')} <span>{String(results.articles.length).padStart(2, '0')}</span>
              </h2>
              <div class="journal-list">
                {results.articles.map((post) => (
                  <a class="journal-item" href={post.url}>
                    <time datetime={post.published_at || undefined}>
                      {formatDate(post.published_at, 'short')}
                    </time>
                    <div>
                      <h3>{post.title}</h3>
                      {post.excerpt && <p>{post.excerpt}</p>}
                    </div>
                    <span class="journal-item__aside">
                      {post.categories?.[0]?.name || '文字'} · {post.reading_time} MIN
                    </span>
                  </a>
                ))}
              </div>
            </section>
          )}
        </>
      )
    }
  </div>
</BaseLayout>
