---
import TaxonomyListing from '../../components/TaxonomyListing.astro';
import { getBootstrap } from '../../lib/api';

const { category: slug } = Astro.params;
const { site, page } = await getBootstrap({ route: 'taxonomy', category: slug || '' });
if (page.kind !== 'taxonomy') throw new Error('unexpected bootstrap payload for a category');
if (!page.term) return Astro.rewrite('/404');
---
<TaxonomyListing
  site={site}
  kind="category"
  term={page.term}
  items={page.items}
  page={page.page}
  pages={page.pages}
  total={page.total}
  basePath={`/categories/${slug || page.term.slug}`}
/>
