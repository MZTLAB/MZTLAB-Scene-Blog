---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { guardAdmin } from '../../lib/auth';
import { getSite } from '../../lib/api';
import { fallbackSite } from '../../config';
import type { SiteSettings } from '../../types';

const guard = await guardAdmin(Astro, 'media.manage');
if (guard instanceof Response) return guard;
const user = guard;

const IMAGE_MIME: Record<string, string> = {
  jpg: 'image/jpeg',
  png: 'image/png',
  webp: 'image/webp',
  gif: 'image/gif',
};
const AUDIO_MIME: Record<string, string> = {
  mp3: 'audio/mpeg',
  m4a: 'audio/mp4',
  ogg: 'audio/ogg',
  oga: 'audio/ogg',
  wav: 'audio/wav',
  flac: 'audio/flac',
};
const FILE_MIME: Record<string, string> = {
  pdf: 'application/pdf',
  zip: 'application/zip',
  txt: 'text/plain',
  md: 'text/markdown',
  csv: 'text/csv',
  json: 'application/json',
  docx: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
  xlsx: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
  pptx: 'application/vnd.openxmlformats-officedocument.presentationml.presentation',
};
let settings: SiteSettings = fallbackSite.settings as unknown as SiteSettings;
try {
  settings = (await getSite()).settings;
} catch {
  // The page still renders with the built-in defaults if the API is briefly down.
}
const parseFormats = (raw: unknown, allowed: string[]): string[] => {
  const tokens = new Set(
    String(raw || '')
      .replace(/;/g, ',')
      .split(',')
      .map((token) => token.trim().toLowerCase().replace(/^\./, '')),
  );
  const selected = allowed.filter((format) => tokens.has(format));
  return selected.length ? selected : allowed;
};
const imageFormats = parseFormats(settings.upload_image_formats, Object.keys(IMAGE_MIME));
const audioFormats = parseFormats(settings.upload_audio_formats, Object.keys(AUDIO_MIME));
const fileFormats = String(settings.upload_file_formats || '').trim()
  ? parseFormats(settings.upload_file_formats, Object.keys(FILE_MIME))
  : [];
const maxMb = Math.max(1, Math.min(200, Number(settings.upload_max_mb) || 12));
const adminUnrestricted = user.role === 'admin';
const accept = [
  ...imageFormats.map((format) => IMAGE_MIME[format]),
  ...audioFormats.map((format) => AUDIO_MIME[format]),
  ...fileFormats.map((format) => FILE_MIME[format]),
].join(',');
const formatSummary = [
  imageFormats.length ? `${imageFormats.map((format) => format.toUpperCase()).join(' / ')} 图片` : '',
  audioFormats.length ? `${audioFormats.map((format) => format.toUpperCase()).join(' / ')} 音频` : '',
  fileFormats.length ? `${fileFormats.map((format) => format.toUpperCase()).join(' / ')} 文件` : '',
]
  .filter(Boolean)
  .join('，以及 ');
const uploadHint = adminUnrestricted
  ? '管理员不受上传设置限制 · 图片可进相册，音频可插入文章，其他文件可复制链接下载'
  : `单个文件不超过 ${maxMb}MB · 图片可进相册，音频可插入文章，其他文件可复制链接下载`;
const descriptionPrefix = adminUnrestricted
  ? '管理员可上传任意格式与大小的文件（服务端技术上限除外）'
  : `支持 ${formatSummary}；单个文件不超过 ${maxMb}MB。上传规则在 设置 → 上传与媒体 中调整。`;
---
<AdminLayout user={user} title="媒体库" subtitle="Assets / Media" active="media">
  <div
    data-media-page
    data-upload-max-mb={maxMb}
    data-upload-image-formats={imageFormats.join(',')}
    data-upload-audio-formats={audioFormats.join(',')}
    data-upload-file-formats={fileFormats.join(',')}
    data-upload-unrestricted={adminUnrestricted ? '1' : '0'}
  >
    <div class="page-head-row">
      <div>
        <h2>图片、音频与文件</h2>
        <p>{descriptionPrefix}</p>
      </div>
      <div class="toolbar-group">
        <a class="a-btn" href="/admin/galleries"><Icon name="camera" size={14} /> 相册</a>
      </div>
    </div>

    <div class="upload-zone" data-upload-zone role="button" tabindex="0" aria-label="上传图片、音频或文件">
      <Icon name="upload" size={30} />
      <strong>拖拽文件到这里，或点击选择</strong>
      <span>{uploadHint}</span>
      <span data-upload-status style="color: var(--accent); font-family: var(--font-mono); font-size: 9px"></span>
      <input type="file" accept={adminUnrestricted ? undefined : accept} multiple data-upload-input />
    </div>

    <div class="admin-toolbar" style="margin-top: 22px">
      <div class="filter-tabs" data-media-kinds>
        <button type="button" class="is-active" data-kind="">全部</button>
        <button type="button" data-kind="image">图片</button>
        <button type="button" data-kind="audio">音频</button>
        <button type="button" data-kind="file">文件</button>
      </div>
      <label class="admin-search">
        <Icon name="search" size={14} />
        <input type="search" placeholder="搜索文件名或替代文字…" data-media-search aria-label="搜索媒体" />
      </label>
    </div>

    <div class="media-grid" data-media-grid>
      <div class="admin-loading" style="grid-column: 1 / -1">
        <div class="skeleton" style="height: 110px"></div>
        <div class="skeleton" style="height: 110px"></div>
      </div>
    </div>

    <div class="table-footer" data-media-pagination style="margin-top: 18px"></div>

    <div class="modal-backdrop" data-exif-editor>
      <div class="modal" role="dialog" aria-modal="true" aria-labelledby="exif-editor-title">
        <form data-exif-form>
          <div class="modal__head">
            <h3 id="exif-editor-title" data-exif-editor-title>编辑 EXIF</h3>
            <button type="button" data-close-exif-editor aria-label="关闭"><Icon name="close" size={15} /></button>
          </div>
          <div class="modal__body">
            <div class="form-grid-2">
              <div class="a-field">
                <label for="exif-camera">相机</label>
                <input id="exif-camera" type="text" maxlength="120" data-exif-camera placeholder="FUJIFILM X-T30 III" />
              </div>
              <div class="a-field">
                <label for="exif-lens">镜头</label>
                <input id="exif-lens" type="text" maxlength="120" data-exif-lens placeholder="17-70mm F/2.8" />
              </div>
              <div class="a-field">
                <label for="exif-taken">拍摄日期</label>
                <input id="exif-taken" type="text" maxlength="10" data-exif-taken placeholder="YYYY-MM-DD" />
              </div>
              <div class="a-field">
                <label for="exif-focal">焦距</label>
                <input id="exif-focal" type="text" maxlength="40" data-exif-focal placeholder="45.1mm" />
              </div>
              <div class="a-field">
                <label for="exif-aperture">光圈</label>
                <input id="exif-aperture" type="text" maxlength="40" data-exif-aperture placeholder="f/5.6" />
              </div>
              <div class="a-field">
                <label for="exif-exposure">快门</label>
                <input id="exif-exposure" type="text" maxlength="40" data-exif-exposure placeholder="1/4000s" />
              </div>
              <div class="a-field">
                <label for="exif-iso">ISO</label>
                <input id="exif-iso" type="number" min="0" max="409600" data-exif-iso placeholder="400" />
              </div>
              <div class="a-field">
                <label for="exif-focal35">等效焦距 <small>mm</small></label>
                <input id="exif-focal35" type="number" min="0" max="2000" data-exif-focal35 placeholder="68" />
              </div>
            </div>
            <p class="hint" style="margin-top:12px">已有 EXIF 字段为只读，只能补充缺失项；保存只更新媒体库数据，不修改原始图像文件。EXIF 是否公开仍由相册页的「显示 EXIF」决定。</p>
          </div>
          <div class="modal__foot">
            <button class="a-btn" type="button" data-close-exif-editor>取消</button>
            <button class="a-btn a-btn--primary" type="submit">保存 EXIF</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import '../../scripts/admin-media';
</script>
