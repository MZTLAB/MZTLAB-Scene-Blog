---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { guardAdmin } from '../../lib/auth';

const guard = await guardAdmin(Astro, 'settings.manage');
if (guard instanceof Response) return guard;
const user = guard;
import '../../styles/admin/settings.css';
---
<AdminLayout user={user} title="设置" subtitle="Site / Settings" active="settings" showCompose={false}>
  <Fragment slot="actions">
    <button class="a-btn a-btn--primary" type="button" data-save-settings><Icon name="save" size={14} /> 保存设置</button>
  </Fragment>

  <div class="settings-layout" data-settings-page>
    <nav class="settings-nav" aria-label="设置分类">
      <button type="button" class="is-active" data-settings-tab="general">常规</button>
      <button type="button" data-settings-tab="reading">阅读</button>
      <button type="button" data-settings-tab="uploads">上传与媒体</button>
      <button type="button" data-settings-tab="images">图片与存储</button>
      <button type="button" data-settings-tab="team">协作与权限</button>
      <button type="button" data-settings-tab="navigation">导航</button>
      <button type="button" data-settings-tab="footer">页脚与社交</button>
      <button type="button" data-settings-tab="seo">SEO 与高级</button>
    </nav>

    <div>
      <section class="settings-panel is-active" data-settings-panel="general">
        <div class="admin-page-intro">
          <div>
            <h2>站点信息</h2>
            <p>站点名称、标语与描述。它们会出现在页面标题、RSS 和搜索结果里；作者信息改为使用成员资料。</p>
          </div>
        </div>
        <div class="admin-card">
          <div class="admin-card__body">
            <div class="setting-row">
              <div class="setting-row__label"><strong>站点名称</strong><span>显示在浏览器标签与页头。</span></div>
              <div class="a-field"><input type="text" maxlength="60" data-setting="site_title" placeholder="MZTLAB" /></div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>英文副名</strong><span>页头品牌下方的小字。</span></div>
              <div class="a-field"><input type="text" maxlength="60" data-setting="site_subtitle" placeholder="SCENE" /></div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>一句话标语</strong><span>用于首页与分享卡片。</span></div>
              <div class="a-field"><input type="text" maxlength="160" data-setting="tagline" /></div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>站点描述</strong><span>给第一次来的读者。</span></div>
              <div class="a-field"><textarea rows="3" maxlength="300" data-setting="description"></textarea></div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>站点地址</strong><span>用于 canonical、RSS 与 sitemap，结尾不要加斜杠。</span></div>
              <div class="a-field"><input type="url" maxlength="200" data-setting="site_url" placeholder="https://example.com" /></div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>Logo / Favicon</strong><span>可选图片地址。Logo 替代默认标记。</span></div>
              <div class="a-field">
                <input type="text" maxlength="500" data-setting="logo" placeholder="Logo URL" style="margin-bottom:8px" />
                <input type="text" maxlength="500" data-setting="favicon" placeholder="Favicon URL" />
              </div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>公告条</strong><span>显示在所有页面顶部，留空则隐藏。</span></div>
              <div class="a-field"><input type="text" maxlength="300" data-setting="announcement" /></div>
            </div>
          </div>
        </div>
      </section>

      <section class="settings-panel" data-settings-panel="reading">
        <div class="admin-page-intro">
          <div><h2>阅读</h2><p>控制文章列表密度与元信息。</p></div>
        </div>
        <div class="admin-card">
          <div class="admin-card__body">
            <div class="setting-row">
              <div class="setting-row__label"><strong>每页文章数</strong><span>首页与分页列表的卡片数量。</span></div>
              <div class="a-field" style="max-width:160px"><input type="number" min="1" max="30" data-setting="posts_per_page" /></div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>显示阅读时间</strong><span>根据中英文字符估算。</span></div>
              <label class="switch" data-switch><input type="checkbox" data-setting="show_reading_time" hidden /><span></span></label>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>显示作者</strong><span>文章页署名与头像。</span></div>
              <label class="switch" data-switch><input type="checkbox" data-setting="show_author" hidden /><span></span></label>
            </div>
          </div>
        </div>
      </section>

      <section class="settings-panel" data-settings-panel="uploads">
        <div class="admin-page-intro">
          <div><h2>上传与媒体</h2><p>控制媒体库与编辑器能上传的文件大小和格式，保存后立即生效。</p></div>
        </div>
        <div class="admin-card">
          <div class="admin-card__body">
            <div class="setting-row">
              <div class="setting-row__label"><strong>最大文件大小</strong><span>单次上传上限，建议 5–50MB。</span></div>
              <div class="a-field" style="max-width:200px;display:flex;align-items:center;gap:8px">
                <input type="number" min="1" max="200" step="1" data-setting="upload_max_mb" />
                <span style="color:var(--ink-faint);font-family:var(--font-mono);font-size:10px">MB</span>
              </div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>允许的图片格式</strong><span>用英文逗号分隔，仅支持 jpg / png / webp / gif。</span></div>
              <div class="a-field"><input type="text" maxlength="80" data-setting="upload_image_formats" placeholder="jpg,png,webp,gif" /></div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>允许的音频格式</strong><span>用英文逗号分隔，仅支持 mp3 / m4a / ogg / oga / wav / flac。</span></div>
              <div class="a-field"><input type="text" maxlength="80" data-setting="upload_audio_formats" placeholder="mp3,m4a,ogg,oga,wav,flac" /></div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>允许的其他文件</strong><span>PDF / ZIP / TXT / MD / CSV / JSON / DOCX / XLSX / PPTX 的子集，用英文逗号分隔；留空则只允许图片和音频。</span></div>
              <div class="a-field"><input type="text" maxlength="120" data-setting="upload_file_formats" placeholder="pdf,zip,txt,md,csv" /></div>
            </div>
          </div>
        </div>
        <div class="admin-card" style="margin-top:16px">
          <div class="admin-card__body">
            <p style="color:var(--ink-faint);font-size:9.5px;line-height:1.7">
              限制只影响新的上传；已上传的文件仍可正常访问与删除。留空或填写未知格式时会回退为全部受支持格式，避免把自己锁在门外。
              <strong style="color:var(--accent)">管理员账号不受这里的格式与大小限制</strong>（仅受服务端技术上限约束），如需限制请用编辑 / 作者账号上传。
            </p>
          </div>
        </div>
      </section>

      <section class="settings-panel" data-settings-panel="images">
        <div class="admin-page-intro">
          <div>
            <h2>图片与存储</h2>
            <p>
              上传的原图永不修改；系统按场景生成 AVIF / WebP / JPEG 副本，质量与编码参数是代码常量，
              不再提供运行时滑杆。这里只控制分辨率阶梯与格式开关。
            </p>
          </div>
        </div>

        <div class="admin-card">
          <div class="admin-card__head"><h3>编码格式</h3><span class="hint" data-codec-status></span></div>
          <div class="admin-card__body">
            <div class="setting-row">
              <div class="setting-row__label"><strong>AVIF</strong><span>首选格式，同质量下体积约为 JPEG 的 30–40%。</span></div>
              <label class="switch" data-switch><input type="checkbox" data-setting="image_avif_enabled" hidden /><span></span></label>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>WebP</strong><span>不支持 AVIF 的浏览器使用。</span></div>
              <label class="switch" data-switch><input type="checkbox" data-setting="image_webp_enabled" hidden /><span></span></label>
            </div>
          </div>
        </div>

        <div class="admin-card" style="margin-top:16px">
          <div class="admin-card__head"><h3>尺寸阶梯与派生图</h3><span>PIPELINE</span></div>
          <div class="admin-card__body">
            <div class="setting-row">
              <div class="setting-row__label"><strong>尺寸阶梯</strong><span>逗号分隔的小图与大图宽度；原图尺寸作为全屏使用。</span></div>
              <div class="a-field"><input type="text" maxlength="60" data-setting="image_widths" placeholder="720,2560" /></div>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:14px">
              <button class="a-btn" type="button" data-optimize-all><Icon name="refresh" size={14} /> 重新生成全部图片</button>
              <span class="hint" data-optimize-status style="align-self:center"></span>
            </div>
            <p class="hint" style="margin-top:10px;color:var(--ink-faint);font-size:9.5px">
              调整阶梯或格式开关只影响之后生成/重新生成的派生图；已有图片继续使用当前产物，
              直到在后台或媒体库手动执行「重新生成」任务。
            </p>
          </div>
        </div>

        <div class="admin-card" style="margin-top:16px">
          <div class="admin-card__head"><h3>对象存储（S3 兼容 / Cloudflare R2）</h3><span class="hint" data-storage-status></span></div>
          <div class="admin-card__body">
            <div class="setting-row">
              <div class="setting-row__label"><strong>存储后端</strong><span>local 使用服务器磁盘；s3 使用 R2 / MinIO / AWS S3。</span></div>
              <div class="a-field" style="max-width:220px">
                <select data-setting="storage_backend">
                  <option value="local">本地磁盘（local）</option>
                  <option value="s3">对象存储（s3）</option>
                </select>
              </div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>图片直连方式</strong><span>auto：配置了公开地址即直连；proxy：始终经后端转发。</span></div>
              <div class="a-field" style="max-width:220px">
                <select data-setting="storage_serve_mode">
                  <option value="auto">自动（auto）</option>
                  <option value="proxy">后端代理（proxy）</option>
                  <option value="direct">强制直连（direct）</option>
                </select>
              </div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>公开访问地址</strong><span>R2 公开域名 / 自定义域名，例如 https://pub-xxxx.r2.dev 或 https://cdn.example.com。留空则不直连。</span></div>
              <div class="a-field"><input type="url" maxlength="500" data-setting="storage_public_base_url" placeholder="https://cdn.example.com" /></div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>R2 Endpoint</strong><span>Cloudflare 控制台 → R2 → 账户详情 → S3 API：https://&lt;账户ID&gt;.r2.cloudflarestorage.com</span></div>
              <div class="a-field"><input type="url" maxlength="500" data-setting="storage_s3_endpoint" placeholder="https://<account>.r2.cloudflarestorage.com" /></div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>Bucket / Region</strong><span>R2 的 region 固定填 auto。</span></div>
              <div class="a-field" style="display:flex;gap:8px">
                <input type="text" maxlength="200" data-setting="storage_s3_bucket" placeholder="mztlab-media" />
                <input type="text" maxlength="60" data-setting="storage_s3_region" placeholder="auto" style="max-width:120px" />
              </div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>访问密钥</strong><span>Access Key / Secret Key 只从服务端环境变量读取（BLOG_S3_ACCESS_KEY / BLOG_S3_SECRET_KEY），不再写入数据库，也不在后台提供输入框。</span></div>
              <div class="a-field"><p class="hint" data-storage-secrets>—</p></div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>对象前缀 / 路径风格</strong><span>同一桶多站点时用前缀区分；MinIO 通常开启路径风格。</span></div>
              <div class="a-field" style="display:flex;align-items:center;gap:10px">
                <input type="text" maxlength="120" data-setting="storage_s3_prefix" placeholder="mztlab" />
                <label class="switch" data-switch title="路径风格寻址"><input type="checkbox" data-setting="storage_s3_path_style" hidden /><span></span></label>
              </div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>保留本地备份</strong><span>写入对象存储的同时，在本地数据目录再存一份（原图 + 派生图）。对象存储不可用时可作灾备，切回本地存储也无需迁移；备份失败只记日志，不影响上传。</span></div>
              <label class="switch" data-switch><input type="checkbox" data-setting="storage_backup_local" hidden /><span></span></label>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:14px">
              <button class="a-btn" type="button" data-storage-test><Icon name="link" size={14} /> 测试连接</button>
              <button class="a-btn" type="button" data-storage-refresh><Icon name="refresh" size={14} /> 存储状态</button>
              <span class="hint" data-storage-result style="align-self:center"></span>
            </div>
            <div class="storage-sync">
              <div class="storage-sync__text">
                <strong>同步本地到远程</strong>
                <span>
                  把服务器本地已存在的原图（含旧数据）与已生成的派生图强制上传到对象存储。
                  默认只补传缺失或大小不一致的文件；勾选「强制覆盖」会重传全部本地文件。
                  后台任务进行中可继续操作，状态会显示进度。
                </span>
              </div>
              <div class="storage-sync__actions">
                <label class="check-row">
                  <input type="checkbox" data-sync-force />
                  <span>强制覆盖远程已有文件</span>
                </label>
                <button class="a-btn" type="button" data-storage-sync>
                  <Icon name="upload" size={14} /> 开始同步
                </button>
                <span class="hint" data-sync-status></span>
              </div>
            </div>
            <p class="hint" style="margin-top:10px;color:var(--ink-faint);font-size:9.5px">
              保存后立即生效（无需重启）。图片直连时，浏览器从对象存储/CDN 拉取派生图；
              原图与未生成完的图片仍走 <code>/media</code> 代理。密钥不会出现在
              <code>/api/site</code>、导出 JSON 或接口响应中。
            </p>
          </div>
        </div>
      </section>

      <section class="settings-panel" data-settings-panel="team">
        <div class="admin-page-intro">
          <div>
            <h2>协作与所有权</h2>
            <p>文章、页面与媒体都有明确的所有者。</p>
          </div>
        </div>
        <div class="admin-card">
          <div class="admin-card__body">
            <div class="setting-row">
              <div class="setting-row__label">
                <strong>编辑可管理他人内容</strong>
                <span>开启（默认）时，编辑可以查看并管理所有成员的文章 / 相册与媒体；关闭后只能编辑、删除自己的内容（分类与导出不受影响）。</span>
              </div>
              <label class="switch" data-switch><input type="checkbox" data-setting="editor_manage_others" hidden /><span></span></label>
            </div>
          </div>
        </div>
        <div class="admin-card" style="margin-top:16px">
          <div class="admin-card__body">
            <p style="color:var(--ink-faint);font-size:9.5px;line-height:1.7">
              所有权规则：文章 / 页面 / 项目与相册统一记录 <code>owner_id</code>，媒体记录 <code>owner_id</code>。
              越权请求由后端返回 403；关闭上面的开关后，后台列表只会显示当前成员自己的内容。
            </p>
          </div>
        </div>
      </section>

      <section class="settings-panel" data-settings-panel="navigation">
        <div class="admin-page-intro">
          <div><h2>导航链接</h2><p>页头与移动端菜单会读取这里；页脚导航与社交链接在「页脚与社交」中单独配置。外部链接请写完整 https:// 地址。</p></div>
        </div>
        <div class="admin-card">
          <div class="admin-card__head"><h3>主导航</h3><button class="a-btn a-btn--sm" type="button" data-add-link="nav"><Icon name="plus" size={13} /> 添加</button></div>
          <div class="admin-card__body">
            <div class="nav-editor" data-links="nav"></div>
            <p class="hint" style="margin-top:10px;color:var(--ink-faint);font-size:9.5px">建议保留「首页 / 影像 / 项目 / 文章 / 关于」。拖动每行左侧的 ⋮⋮ 手柄调整顺序（聚焦手柄后也可用 ↑ ↓ 键）；手机上用每行右侧的 ↑ ↓ 按钮。</p>
          </div>
        </div>
      </section>

      <section class="settings-panel" data-settings-panel="footer">
        <div class="admin-page-intro">
          <div><h2>页脚与社交</h2><p>这些内容会出现在每一页的底部。</p></div>
        </div>
        <div class="admin-card">
          <div class="admin-card__body">
            <div class="setting-row">
              <div class="setting-row__label"><strong>页脚短句</strong><span>品牌下方的一行文字。</span></div>
              <div class="a-field"><textarea rows="2" maxlength="200" data-setting="footer_text"></textarea></div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>版权备注</strong><span>例如 Built with Astro × FastAPI。</span></div>
              <div class="a-field"><input type="text" maxlength="200" data-setting="footer_note" /></div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>备案号</strong><span>可选，显示在页脚底部。</span></div>
              <div class="a-field"><input type="text" maxlength="80" data-setting="icp" /></div>
            </div>
          </div>
        </div>
        <div class="admin-card" style="margin-top:16px">
          <div class="admin-card__head">
            <h3>页脚导航链接</h3>
            <button class="a-btn a-btn--sm" type="button" data-add-link="footer"><Icon name="plus" size={13} /> 添加</button>
          </div>
          <div class="admin-card__body">
            <div class="nav-editor" data-links="footer"></div>
            <p class="hint" style="margin-top:10px;color:var(--ink-faint);font-size:9.5px">
              这些是页脚里的普通导航链接（影像 / 项目 / 文字 / 搜索 / 后台），显示在社交媒体图标之后。
              留空时使用默认的五个入口；社交媒体请用下面的「社交链接」单独配置。
              拖动每行左侧的 ⋮⋮ 手柄可调整顺序（聚焦后也可用 ↑ ↓ 键）；手机上用每行右侧的 ↑ ↓ 按钮。
            </p>
          </div>
        </div>
        <div class="admin-card" style="margin-top:16px">
          <div class="admin-card__head"><h3>社交链接</h3><button class="a-btn a-btn--sm" type="button" data-add-link="social"><Icon name="plus" size={13} /> 添加</button></div>
          <div class="admin-card__body">
            <div class="nav-editor" data-links="social"></div>
            <p class="hint" style="margin-top:10px;color:var(--ink-faint);font-size:9.5px">社交媒体显示为带图标的链接，与页脚导航分开。同样可拖动 ⋮⋮ 手柄排序，手机端使用右侧 ↑ ↓ 按钮。</p>
          </div>
        </div>
      </section>

      <section class="settings-panel" data-settings-panel="seo">
        <div class="admin-page-intro">
          <div><h2>SEO 与高级</h2><p>搜索引擎、分享卡片，以及需要直接写入页头的代码。</p></div>
        </div>
        <div class="admin-card">
          <div class="admin-card__body">
            <div class="setting-row">
              <div class="setting-row__label"><strong>SEO 描述</strong><span>默认页面描述，文章可单独覆盖。</span></div>
              <div class="a-field"><textarea rows="3" maxlength="300" data-setting="seo_description"></textarea></div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>关键词</strong><span>用英文逗号分隔。现代搜索引擎权重很低。</span></div>
              <div class="a-field"><input type="text" maxlength="200" data-setting="seo_keywords" /></div>
            </div>
            <div class="setting-row">
              <div class="setting-row__label"><strong>默认分享图</strong><span>Open Graph 图片，建议 1200×630。</span></div>
              <div class="a-field"><input type="text" maxlength="500" data-setting="og_image" /></div>
            </div>
            <div class="setting-row">
