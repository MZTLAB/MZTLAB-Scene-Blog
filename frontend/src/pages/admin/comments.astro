---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { guardAdmin } from '../../lib/auth';

const guard = await guardAdmin(Astro, 'comment.moderate');
if (guard instanceof Response) return guard;
const user = guard;
---
<AdminLayout user={user} title="评论" subtitle="Community / Comments" active="comments">
  <div data-comments-page>
    <div class="page-head-row">
      <div>
        <h2>读者留言</h2>
        <p>默认需要审核后才会公开。垃圾留言可以直接删除；通过之后会立即出现在文章末尾。</p>
      </div>
    </div>

    <div class="admin-toolbar">
      <div class="filter-tabs" data-comment-filters>
        <button type="button" class="is-active" data-status="">全部 <small>0</small></button>
        <button type="button" data-status="pending">待审核 <small>0</small></button>
        <button type="button" data-status="approved">已通过 <small>0</small></button>
        <button type="button" data-status="spam">垃圾 <small>0</small></button>
      </div>
      <div class="toolbar-group">
        <label class="admin-search">
          <Icon name="search" size={14} />
          <input type="search" placeholder="搜索留言或人名…" data-comment-search aria-label="搜索评论" />
        </label>
      </div>
    </div>

    <div class="admin-card">
      <div data-comment-list>
        <div class="admin-loading">
          <div class="skeleton" style="height: 70px"></div>
          <div class="skeleton" style="height: 70px"></div>
        </div>
      </div>
      <div class="table-footer" data-comment-pagination></div>
    </div>
  </div>
</AdminLayout>

<script>
  import '../../scripts/admin-comments';
</script>
