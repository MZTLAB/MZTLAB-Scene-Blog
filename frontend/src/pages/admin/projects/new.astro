---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PostEditor from '../../../components/admin/PostEditor.astro';
import { guardAdmin } from '../../../lib/auth';

const guard = await guardAdmin(Astro, 'content.write');
if (guard instanceof Response) return guard;
const user = guard;
---
<AdminLayout user={user} title="新建项目" subtitle="Studio / New project" active="projects" showCompose={false}>
  <PostEditor mode="new" postType="project" />
</AdminLayout>
