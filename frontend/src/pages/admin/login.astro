---
import AuthLayout from '../../layouts/AuthLayout.astro';
import Icon from '../../components/Icon.astro';
import { getAuthStatus } from '../../lib/auth';
import { getSite } from '../../lib/api';
import { fallbackSite } from '../../config';
import type { SiteInfo } from '../../types';

const status = await getAuthStatus(Astro);
if (status.needs_setup) return Astro.redirect('/admin/setup');
if (status.authenticated) return Astro.redirect('/admin');

let site: SiteInfo = fallbackSite as unknown as SiteInfo;
try {
  site = await getSite();
} catch {
  // fallback tokens
}
const requested = Astro.url.searchParams.get('next') || '/admin';
const next = requested.startsWith('/admin') ? requested : '/admin';
---
<AuthLayout site={site} mode="login">
  <h1>回到工作台。</h1>
  <p>输入账号继续。</p>

  <form class="auth-form" data-login-form data-next={next}>
    <div class="a-field">
      <label for="username">用户名</label>
      <input id="username" name="username" type="text" autocomplete="username" required autofocus />
    </div>
    <div class="a-field">
      <label for="password">密码</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required />
    </div>
    <div class="auth-error" data-auth-error role="alert"></div>
    <button class="a-btn a-btn--primary" type="submit" style="justify-content: center; min-height: 42px">
      登录 <Icon name="arrowRight" size={15} />
    </button>
  </form>

</AuthLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-login-form]');
  const errorBox = document.querySelector<HTMLElement>('[data-auth-error]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    if (errorBox) errorBox.textContent = '';
    const payload = Object.fromEntries(new FormData(form).entries());
    try {
      const response = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.detail || '登录失败');
      window.location.href = form.dataset.next || data.redirect || '/admin';
    } catch (error) {
      if (errorBox) errorBox.textContent = error instanceof Error ? error.message : '登录失败';
      if (button) button.disabled = false;
    }
  });
</script>
