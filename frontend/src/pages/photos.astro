---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryCard from '../components/GalleryCard.astro';
import Icon from '../components/Icon.astro';
import { getBootstrap } from '../lib/api';
import { copyReader } from '../lib/site';

const { site, page: galleryPage } = await getBootstrap({ route: 'galleries' });
if (galleryPage.kind !== 'galleries') throw new Error('unexpected bootstrap payload for /photos');
const { site: siteSettings } = site.settings;
const copy = copyReader(site.settings);
const galleries = galleryPage.items;
const columns = Math.min(4, Math.max(2, Number(siteSettings.gallery_columns) || 3));
---
<BaseLayout site={site} title={copy('photos_title', '影像')} description={`${siteSettings.site_title} 的影像相册。`}>
  <section class="container page-hero page-hero--code">
    <span class="eyebrow">{copy('photos_eyebrow', '// PHOTOS')}</span>
    <h1>{copy('photos_title', '影像')}</h1>
    <p>{copy('photos_lead', '以相册整理光线、空间与痕迹。')}</p>
    <div class="page-hero__meta">
      <span>{String(galleries.length).padStart(2, '0')} ALBUMS</span>
      <span>/</span>
      <span>{String(site.photo_count).padStart(2, '0')} FRAMES</span>
      <span>/</span>
      <span>RECENT_FIRST</span>
    </div>
  </section>

  <div class="container">
    {
      galleries.length > 0 ? (
        <div class="gallery-grid" style={`--gallery-columns:${columns}`}>
          {galleries.map((gallery, index) => (
            <GalleryCard gallery={gallery} label={siteSettings.site_title} index={index + 1} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <span class="empty-mark">[ ]</span>
          <h2>{copy('photos_empty_title', '还没有相册')}</h2>
          <p>{copy('photos_empty_text', '新建相册，再从媒体库选照片。')}</p>
          <a class="btn" href="/admin/galleries" style="margin-top: 18px">
            {copy('photos_empty_cta', '管理相册')} <Icon name="arrowRight" size={14} />
          </a>
        </div>
      )
    }
  </div>
</BaseLayout>
