---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SmartImage from '../components/SmartImage.astro';
import Icon from '../components/Icon.astro';
import { getBootstrap } from '../lib/api';
import { formatDate } from '../lib/format';
import { isValidImage, isReady, srcset as imageSrcset } from '../lib/images';
import { copyReader } from '../lib/site';

const { site, page: home } = await getBootstrap({ route: 'home' });
if (home.kind !== 'home') throw new Error('unexpected bootstrap payload for home');
const { site: siteSettings, appearance } = site.settings;
const copy = copyReader(site.settings);

// The aggregated payload is the only request this page makes (R1).
const galleries = home.galleries;
const projects = home.projects;
const articles = home.posts;

const featuredGallery = galleries.find((gallery) => gallery.featured) || galleries[0] || null;
const photoItems = galleries.slice(0, 3);
const projectItems = projects.slice(0, 3);
const articleItems = articles.slice(0, 3);
const isEmpty = photoItems.length === 0 && projectItems.length === 0 && articleItems.length === 0;

const counts = {
  photos: site.photo_count || 0,
  projects: site.project_count || 0,
  texts: site.post_count || 0,
};
const two = (value: number) => String(value).padStart(2, '0');
// When the hero image comes from the featured gallery (no configured
// hero_image) BaseLayout cannot preload it, so the home page adds the hint.
const heroCover = featuredGallery?.cover?.image ?? null;
const heroPreload =
  !appearance.hero_image &&
  appearance.hero_show &&
  isValidImage(heroCover) &&
  isReady(heroCover) &&
  heroCover.formats.includes('avif')
    ? imageSrcset(heroCover, 'hero', 'avif')
    : '';
import '../styles/site/home/pillars.css';
import '../styles/site/home/cta-band.css';
import '../styles/site/ui/empty-state.css';
---
<BaseLayout site={site} description={siteSettings.description || siteSettings.seo_description}>
  {heroPreload && (
    <Fragment slot="head">
      <link
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset={heroPreload}
        imagesizes="100vw"
        fetchpriority="high"
      />
    </Fragment>
  )}
  {appearance.hero_show && <HomeHero site={site} featuredGallery={featuredGallery} />}

  {!isEmpty && (
    <section class="container index-section" id="index">
      <header class="index-head">
        <span class="section-code">// SCENE</span>
        <div class="index-head__row">
          <h2>{copy('index_title', '场景')}</h2>
          <p>{copy('index_lead', '三个入口：照片、项目与文字。各自独立，也彼此参照。')}</p>
        </div>
      </header>

      <div class="pillars">
        <article class="pillar" data-pillar="photos">
          <header class="pillar__head">
            <a class="pillar__title" href="/photos">
              <span class="pillar__index">01</span>
              <h3>{copy('photos_title', '影像')}</h3>
              <span class="pillar__count">{two(counts.photos)}</span>
            </a>
            <p>{copy('photos_lead', '以相册整理光线、空间与痕迹。')}</p>
          </header>

          <div class="pillar__body">
            {photoItems.length > 0 ? (
              photoItems.map((gallery) => (
                <a class="pillar__photo" href={gallery.url}>
                  <span class="pillar__thumb">
                    {gallery.cover ? (
                      <SmartImage
                        image={gallery.cover.image}
                        src={gallery.cover.url}
                        alt={gallery.cover.alt}
                        scene="tile"
                      />
                    ) : (
                      <span class="pillar__thumb-empty" aria-hidden="true">[ {two(gallery.photo_count)} ]</span>
                    )}
                  </span>
                  <span class="pillar__meta">
                    <strong>{gallery.title}</strong>
                    <span>{two(gallery.photo_count)} FRAMES</span>
                  </span>
                </a>
              ))
            ) : (
              <p class="pillar__empty">{copy('photos_empty_text', '新建相册，再从媒体库选照片。')}</p>
            )}
          </div>

          <footer class="pillar__foot">
            <a class="text-link" href="/photos">
              {copy('photos_link', '全部影像')} <Icon name="arrowRight" size={13} />
            </a>
          </footer>
        </article>

        <article class="pillar" data-pillar="projects">
          <header class="pillar__head">
            <a class="pillar__title" href="/projects">
              <span class="pillar__index">02</span>
              <h3>{copy('projects_title', '项目')}</h3>
              <span class="pillar__count">{two(counts.projects)}</span>
            </a>
            <p>{copy('projects_lead', '代码与设计，记录做法与结果。')}</p>
          </header>

          <div class="pillar__body">
            {projectItems.length > 0 ? (
              projectItems.map((project, index) => (
                <ProjectCard project={project} index={index} compact />
              ))
            ) : (
              <p class="pillar__empty">{copy('projects_empty_text', '新建一个项目，写下它解决的问题。')}</p>
            )}
          </div>

          <footer class="pillar__foot">
            <a class="text-link" href="/projects">
              {copy('projects_link', '全部项目')} <Icon name="arrowRight" size={13} />
            </a>
          </footer>
        </article>

        <article class="pillar" data-pillar="texts">
          <header class="pillar__head">
            <a class="pillar__title" href="/archive">
              <span class="pillar__index">03</span>
              <h3>{copy('texts_title', '文字')}</h3>
              <span class="pillar__count">{two(counts.texts)}</span>
            </a>
            <p>{copy('texts_lead', '笔墨之痕，以篇章留存。')}</p>
          </header>

          <div class="pillar__body">
            {articleItems.length > 0 ? (
              articleItems.map((post, index) => (
                <a class="pillar__text" href={post.url}>
                  <span class="pillar__text-index">{String(index + 1).padStart(2, '0')}</span>
                  <span class="pillar__meta">
                    <strong>{post.title}</strong>
                    <span>{formatDate(post.published_at, 'short')} {post.reading_time ? `· ${post.reading_time} MIN` : ''}</span>
                  </span>
                </a>
              ))
            ) : (
              <p class="pillar__empty">{copy('texts_empty_text', '写下一篇文章，让时间有迹可循。')}</p>
            )}
          </div>

          <footer class="pillar__foot">
            <a class="text-link" href="/archive">
              {copy('texts_link', '全部文字')} <Icon name="arrowRight" size={13} />
            </a>
          </footer>
        </article>
      </div>
    </section>
  )}

  {isEmpty && (
    <section class="container empty-state">
      <span class="empty-mark">[ ]</span>
      <h2>{copy('home_empty_title', '空场景')}</h2>
      <p>{copy('home_empty_text', '上传照片、建立相册，或写一篇文章。')}</p>
      <a class="btn" href="/admin" style="margin-top: 18px">
        {copy('home_empty_cta', '进入后台')} <Icon name="arrowRight" size={14} />
      </a>
    </section>
  )}

  <section class="container">
    <div class="cta-band">
      <div>
        <span class="section-code">// SYNDICATION</span>
        <h3>{copy('cta_title', '保持联系。')}</h3>
        <p>{copy('cta_text', '订阅 RSS，或者先从场景里挑一个入口。')}</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn--ghost" href="/rss.xml"><Icon name="rss" size={14} /> {copy('cta_rss', 'RSS')}</a>
        <a class="btn" href="/search">{copy('cta_search', '搜索')} <Icon name="search" size={14} /></a>
      </div>
    </div>
  </section>
</BaseLayout>
