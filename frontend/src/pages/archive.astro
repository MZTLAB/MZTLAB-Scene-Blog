---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import StoryCard from '../components/StoryCard.astro';
import { apiServer, getSite } from '../lib/api';
import type { PostSummary, SiteInfo } from '../types';

const site: SiteInfo = await getSite();
const data = await apiServer<{
  items: PostSummary[];
  total: number;
  years: Array<{ year: string; count: number }>;
}>('/api/archive');
const groups = data.years.map((year) => ({
  ...year,
  posts: data.items.filter((post) => (post.published_at || '').startsWith(year.year)),
}));
const settings = site.settings;
const copy = (key: keyof typeof settings, fallback: string) => {
  const value = settings[key];
  return typeof value === 'string' && value.trim() ? value : fallback;
};
const layout = settings.post_layout === 'list' ? 'list' : 'grid';
---
<BaseLayout site={site} title="文章归档" description={`${settings.site_title} 的全部文章归档。`}>
  <section class="container page-hero">
    <span class="eyebrow">{copy('copy_texts_eyebrow', '// TEXT_ARCHIVE')}</span>
    <h1>{copy('copy_texts_title', '文字')}</h1>
    <p>{copy('copy_texts_lead', '笔墨之痕，以篇章留存。')}</p>
    <div class="page-hero__meta">
      <span>{String(data.total).padStart(2, '0')} TEXTS</span>
      <span>/</span>
      <span>{String(groups.length).padStart(2, '0')} YEARS</span>
    </div>
    <form class="search-form" action="/search" method="get">
      <Icon name="search" size={15} />
      <input name="q" type="search" placeholder={copy('copy_search_placeholder', '输入关键词')} aria-label="搜索文章" />
      <button class="btn btn--small" type="submit">{copy('copy_cta_search', '搜索')}</button>
    </form>
  </section>

  <div class="container">
    <div class="archive-toolbar">
      <div class="archive-years" data-year-filter>
        <button type="button" class="is-active" data-year="all">ALL {data.total}</button>
        {
          groups.map((group) => (
            <button type="button" data-year={group.year}>
              {group.year} {group.count}
            </button>
          ))
        }
      </div>
      <span class="number-label">
        {data.items.length
          ? `FROM ${data.items[data.items.length - 1].published_at?.slice(0, 10)}`
          : 'EMPTY'}
      </span>
    </div>

    {
      groups.length ? (
        groups.map((group) => (
          <section class="archive-year" data-year-group={group.year}>
            <div class="archive-year__label">
              <strong>{group.year}</strong>
              <span>{String(group.count).padStart(2, '0')} entries</span>
            </div>
            <div class:list={['story-layout', `story-layout--${layout}`]}>
              {group.posts.map((post, index) => (
                <StoryCard
                  post={post}
                  site={site}
                  label={settings.site_title}
                  eager={group.year === groups[0]?.year && index < 3}
                />
              ))}
            </div>
          </section>
        ))
      ) : (
        <div class="empty-state">
          <span class="empty-mark">[ ]</span>
          <h2>{copy('copy_texts_empty_title', '还没有文章')}</h2>
          <p>{copy('copy_texts_empty_text', '写下一篇文章，让时间有迹可循。')}</p>
          <a class="btn" href="/admin/posts/new" style="margin-top: 18px">
            {copy('copy_texts_empty_cta', '写文章')} <Icon name="arrowRight" size={14} />
          </a>
        </div>
      )
    }
  </div>

  <script>
    const filter = document.querySelector('[data-year-filter]');
    filter?.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
      button.addEventListener('click', () => {
        filter.querySelectorAll('button').forEach((item) => item.classList.remove('is-active'));
        button.classList.add('is-active');
        const year = button.dataset.year;
        document.querySelectorAll<HTMLElement>('[data-year-group]').forEach((group) => {
          group.style.display = year === 'all' || group.dataset.yearGroup === year ? '' : 'none';
        });
      });
    });
  </script>
</BaseLayout>
