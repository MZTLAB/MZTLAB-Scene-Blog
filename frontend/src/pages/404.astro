---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getBootstrap } from '../lib/api';

// A 404 still shows the full site chrome (header/footer/tokens) exactly like
// 2.x did. It only reads the aggregated public bootstrap payload, so a future
// SSG build can emit the page without a backend; no request-context access.
const { site } = await getBootstrap({ route: 'home' });
const copy = site.settings.copy;
Astro.response.status = 404;
---
<BaseLayout site={site} title="404" noindex>
  <section class="container notfound">
    <strong>404</strong>
    <h1>{copy.notfound_title || '场景不存在'}</h1>
    <p>{copy.notfound_text || '换一个地址，或者回到首页。'}</p>
    <div class="notfound-actions">
      <a class="btn" href="/"><Icon name="home" size={14} /> {copy.notfound_cta || '回到首页'}</a>
      <a class="btn btn--ghost" href="/photos">{copy.photos_title || '影像'} <Icon name="arrowRight" size={14} /></a>
      <a class="btn btn--ghost" href="/projects">{copy.projects_title || '项目'}</a>
      <a class="btn btn--ghost" href="/archive">{copy.texts_title || '文字'}</a>
    </div>
  </section>
</BaseLayout>
