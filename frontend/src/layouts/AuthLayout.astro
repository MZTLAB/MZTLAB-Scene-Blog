---
import { normalizeTheme } from '../lib/theme';
import type { SiteInfo } from '../types';

interface Props {
  site: SiteInfo;
  mode?: 'login' | 'setup';
}

const { site, mode = 'login' } = Astro.props;
const { site: siteSettings, appearance } = site.settings;
const tokens = normalizeTheme(appearance, siteSettings);
const markSrc = siteSettings.favicon || '/favicon.svg';
import '../styles/tokens/layers.css';
import '../styles/tokens/typography.css';
import '../styles/tokens/accent.css';
import '../styles/tokens/palette.css';
import '../styles/tokens/metrics.css';
import '../styles/tokens/admin/palette.css';
import '../styles/tokens/admin/metrics.css';
import '../styles/base/reset.css';
import '../styles/base/elements.css';
import '../styles/base/layout.css';
import '../styles/base/type-devices.css';
import '../styles/shared/brand.css';
import '../styles/shared/icon-btn.css';
import '../styles/admin/auth.css';
import '../styles/admin/buttons.css';
import '../styles/admin/forms.css';
---

<!doctype html>
<html
  lang="zh-CN"
  data-color-mode={tokens.colorMode}
  data-palette={tokens.palette}
  data-font={tokens.fontPair}
  data-theme="scene"
  style={`--accent:${tokens.accent};--radius:${tokens.radius}px`}
>
  <head>
    <style is:inline>
      @layer tokens, base, components, pages, utilities;
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{mode === 'setup' ? '初始化站点' : '登录'} · {siteSettings.site_title}</title>
    <link rel="icon" href={markSrc} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const stored =
            localStorage.getItem('scene-color-mode') || localStorage.getItem('ink-color-mode');
          let mode = stored || root.dataset.colorMode || 'light';
          if (mode === 'system') {
            mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          root.dataset.colorMode = mode;
          root.style.colorScheme = mode;
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <div class="auth-body">
      <aside class="auth-aside">
        <a class="brand" href="/" style="color: inherit">
          <img
            class="brand-mark"
            src={markSrc}
            alt=""
            width="32"
            height="32"
            style="width:32px;height:32px"
            aria-hidden="true"
          />
          <span class="brand-text">
            <span class="brand-title">{siteSettings.site_title}</span>
            <span class="brand-sub">{siteSettings.site_subtitle || 'SCENE'}</span>
          </span>
        </a>
        <div class="auth-aside__quote">
          <p>{siteSettings.tagline || '影像与文字。'}</p>
          <span>Photography / Writing</span>
        </div>
        <div class="auth-aside__foot">
          <span>SCENE</span>
          <span>ASTRO × FASTAPI</span>
          <span>EST. {new Date().getFullYear()}</span>
        </div>
      </aside>
      <main class="auth-main">
        <div class="auth-card">
          <span class="eyebrow">
            <span class="dot"></span>
            {mode === 'setup' ? 'First run' : 'Welcome back'}
          </span>
          <slot />
          <p class="auth-foot">
            <a href="/">← 返回网站</a>
          </p>
        </div>
      </main>
    </div>
  </body>
</html>
