---
import Icon from '../components/Icon.astro';

import { getSite } from '../lib/api';
import { initial } from '../lib/format';
import { normalizeTheme } from '../lib/theme';
import type { AdminUser, SiteInfo } from '../types';

interface Props {
  user: AdminUser;
  title: string;
  subtitle?: string;
  active: string;
  showCompose?: boolean;
}

const { user, title, subtitle = '', active, showCompose = true } = Astro.props;

const site: SiteInfo = await getSite();
const { site: siteSettings, appearance } = site.settings;
const tokens = normalizeTheme(appearance, siteSettings);
const markSrc = siteSettings.favicon || '/favicon.svg';

const can = (permission: string) => user.permissions?.includes(permission) ?? false;
const canCompose = can('content.write');
const nav = [
  { key: 'dashboard', label: '概览', href: '/admin', icon: 'dashboard', show: true },
  {
    key: 'photography',
    label: '影像',
    href: '/admin/galleries',
    icon: 'camera',
    show: can('gallery.manage'),
  },
  { key: 'projects', label: '项目', href: '/admin/projects', icon: 'code', show: true },
  { key: 'posts', label: '文章', href: '/admin/posts', icon: 'file', show: true },
  { key: 'pages', label: '页面', href: '/admin/pages', icon: 'book', show: can('content.others') },
  { key: 'media', label: '媒体库', href: '/admin/media', icon: 'image', show: can('media.manage') },
  {
    key: 'taxonomy',
    label: '分类与标签',
    href: '/admin/taxonomy',
    icon: 'folder',
    show: can('taxonomy.manage'),
  },
].filter((item) => item.show);
const siteNav = [
  {
    key: 'appearance',
    label: '外观',
    href: '/admin/appearance',
    icon: 'palette',
    show: can('settings.manage'),
  },
  { key: 'users', label: '成员', href: '/admin/users', icon: 'users', show: can('users.manage') },
  {
    key: 'settings',
    label: '设置',
    href: '/admin/settings',
    icon: 'settings',
    show: can('settings.manage'),
  },
].filter((item) => item.show);
const isActive = (key: string) => active === key;
const composeHref = '/admin/posts/new';
import '../styles/tokens/layers.css';
import '../styles/tokens/typography.css';
import '../styles/tokens/accent.css';
import '../styles/tokens/palette.css';
import '../styles/tokens/metrics.css';
import '../styles/tokens/admin/palette.css';
import '../styles/tokens/admin/metrics.css';
import '../styles/base/reset.css';
import '../styles/base/elements.css';
import '../styles/base/layout.css';
import '../styles/base/type-devices.css';
import '../styles/shared/brand.css';
import '../styles/shared/icon-btn.css';
import '../styles/shared/avatar.css';
import '../styles/shared/prose.css';
import '../styles/admin/shell.css';
import '../styles/admin/nav.css';
import '../styles/admin/topbar.css';
import '../styles/admin/cards.css';
import '../styles/admin/dashboard.css';
import '../styles/admin/tables.css';
import '../styles/admin/badges.css';
import '../styles/admin/toolbar.css';
import '../styles/admin/buttons.css';
import '../styles/admin/forms.css';
import '../styles/admin/modal.css';
import '../styles/admin/feedback.css';
import '../styles/audio-player.css';
---

<!doctype html>
<html
  lang="zh-CN"
  data-color-mode={tokens.colorMode}
  data-palette={tokens.palette}
  data-font={tokens.fontPair}
  style={`--accent:${tokens.accent};--layout-width:${tokens.width}px;--radius:${tokens.radius}px`}
>
  <head>
    <style is:inline>
      @layer tokens, base, components, pages, utilities;
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={tokens.accent} />
    <title>{title} · {siteSettings.site_title} · Scene</title>
    <link rel="icon" href={markSrc} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const stored =
            localStorage.getItem('scene-color-mode') || localStorage.getItem('ink-color-mode');
          let mode = stored || root.dataset.colorMode || 'light';
          if (mode === 'system') {
            mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          root.dataset.colorMode = mode;
          root.style.colorScheme = mode;
        } catch (_) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="admin-body" data-role={user.role}>
    <div class="admin-shell">
      <aside class="admin-sidebar" aria-label="管理导航">
        <a class="admin-brand" href="/admin">
          <img class="brand-mark" src={markSrc} alt="" width="22" height="22" aria-hidden="true" />
          <span class="admin-brand__text">
            <strong>{siteSettings.site_title}</strong>
            <span>mono studio</span>
          </span>
        </a>

        <nav class="admin-nav">
          <span class="admin-nav__label">Studio</span>
          {nav.map((item) => (
            <a href={item.href} class:list={[{ 'is-active': isActive(item.key) }]}>
              <Icon name={item.icon} size={17} />
              {item.label}
            </a>
          ))}
          {siteNav.length > 0 && <span class="admin-nav__label">Site</span>}
          {siteNav.map((item) => (
            <a href={item.href} class:list={[{ 'is-active': isActive(item.key) }]}>
              <Icon name={item.icon} size={17} />
              {item.label}
            </a>
          ))}
        </nav>

        <div class="admin-sidebar__foot">
          <a href="/admin/profile">
            <Icon name="users" size={15} /> 个人资料
          </a>
          <a href="/" target="_blank" rel="noopener">
            <Icon name="external" size={15} /> 查看站点
          </a>
          <button type="button" data-logout>
            <Icon name="logout" size={15} /> 退出登录
          </button>
        </div>
      </aside>

      <div class="admin-backdrop" data-admin-backdrop></div>

      <div class="admin-main">
        <header class="admin-topbar">
          <button
            class="icon-btn admin-menu-btn"
            type="button"
            data-admin-menu
            aria-label="打开菜单"
          >
            <Icon name="menu" />
          </button>
          <div class="admin-topbar__title">
            <span class="crumb">{subtitle || 'MZTLAB // SCENE'}</span>
            <h1>{title}</h1>
          </div>
          <div class="admin-topbar__actions">
            <slot name="actions" />
            {showCompose && canCompose && (
              <a class="a-btn a-btn--primary" href={composeHref}>
                <Icon name="plus" size={14} /> 写文章
              </a>
            )}
            <div
              class="admin-user"
              title={`${user.display_name} · ${user.role_label || user.role}`}
            >
              <span class="avatar">
                {user.avatar ? <img src={user.avatar} alt="" /> : initial(user.display_name)}
              </span>
              <span class="admin-user__meta">
                <strong>{user.display_name}</strong>
                <span>{user.role_label || user.role}</span>
              </span>
            </div>
          </div>
        </header>

        <main class="admin-content" id="main">
          <slot />
        </main>
      </div>
    </div>

    <div class="toast-root" id="toastRoot"></div>

    <script>
      import { initAdminShell } from '../lib/admin-client';
      initAdminShell();
    </script>
    <script>
      import '../scripts/audio-player';
    </script>
  </body>
</html>
