---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Lightbox from '../components/Lightbox.astro';
import '../styles/global.css';
import '../styles/mono.css';
import '../styles/index.css';
import '../styles/audio-player.css';
import { absoluteUrl, stripStyleClose } from '../lib/format';
import { isValidImage, srcset as imageSrcset } from '../lib/images';
import { copyReader, themeTokens } from '../lib/site';
import type { SiteInfo } from '../types';

interface Props {
  site: SiteInfo;
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  bodyClass?: string;
  /** Author of the current article/project/gallery, for <meta name="author">. */
  author?: string;
}

const {
  site,
  title,
  description,
  image,
  type = 'website',
  noindex = false,
  bodyClass = '',
  author = '',
} = Astro.props;

const { site: siteSettings, appearance } = site.settings;
const copy = copyReader(site.settings);
const tokens = themeTokens(appearance, siteSettings);
const siteTitle = siteSettings.site_title;
const pageTitle = title ? `${title} — ${siteTitle}` : `${siteTitle} · ${siteSettings.site_subtitle}`;
const metaDescription = description || siteSettings.seo_description || siteSettings.description;
const canonical = absoluteUrl(siteSettings.site_url, Astro.url.pathname);
const ogImage = image || siteSettings.og_image;
const favicon = siteSettings.favicon || '/favicon.svg';
const css = stripStyleClose(appearance.custom_css || '');
const heroImage = (appearance.hero_image || '').replace(/["'\\]/g, encodeURIComponent);
const rootStyle = [
  `--accent:${tokens.accent}`,
  `--layout-width:${tokens.width}px`,
  `--radius:${tokens.radius}px`,
  `--photo-columns:${tokens.columns}`,
  heroImage ? `--hero-image:url("${heroImage}")` : '',
].filter(Boolean).join(';');
// Preload the first-screen hero (AVIF) instead of waiting for HTML parsing.
const heroInfo = isValidImage(site.hero_image_info) ? site.hero_image_info : null;
const heroPreload =
  appearance.hero_show && heroInfo && heroInfo.formats.includes('avif')
    ? imageSrcset(heroInfo, 'hero', 'avif')
    : '';
---
<!doctype html>
<html
  lang="zh-CN"
  data-color-mode={tokens.colorMode}
  data-palette={tokens.palette}
  data-font={tokens.fontPair}
  data-theme="scene"
  style={rootStyle}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {siteSettings.seo_keywords && <meta name="keywords" content={siteSettings.seo_keywords} />}
    <meta name="author" content={author || siteTitle} />
    <meta name="theme-color" content={tokens.accent} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} />
    {heroPreload && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset={heroPreload}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS`} href="/rss.xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    {ogImage && <meta property="og:image" content={absoluteUrl(siteSettings.site_url, ogImage)} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const stored =
            localStorage.getItem('scene-color-mode') || localStorage.getItem('ink-color-mode');
          let mode = stored || root.dataset.colorMode || 'light';
          if (mode === 'system') {
            mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          root.dataset.colorMode = mode;
          root.style.colorScheme = mode;
        } catch (_) {
          // storage can be unavailable; the server-rendered value still works
        }
      })();
    </script>

    {appearance.head_html && <Fragment set:html={appearance.head_html} />}
    <slot name="head" />
  </head>

  <body class:list={['site-body', bodyClass]} id="top">
    <a class="skip-link" href="#main">{copy('skip_link', '跳到正文')}</a>
    {siteSettings.announcement && (
      <div class="announcement">
        <div class="container">{siteSettings.announcement}</div>
      </div>
    )}
    <SiteHeader site={site} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter site={site} />
    <Lightbox />
    {css && <style is:inline set:html={css}></style>}

    <script>
      const header = document.getElementById('siteHeader');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const themeToggle = document.querySelector('[data-theme-toggle]');
      themeToggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.colorMode === 'dark' ? 'light' : 'dark';
        root.dataset.colorMode = next;
        root.style.colorScheme = next;
        try {
          localStorage.setItem('scene-color-mode', next);
        } catch (_) {
          // ignore
        }
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          'content',
          next === 'dark'
            ? '#0c0c0b'
            : getComputedStyle(root).getPropertyValue('--accent').trim(),
        );
      });

      const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const mobileNav = document.getElementById('mobileNav');
      const setMenuIcon = (open: boolean) => {
        if (!menuToggle) return;
        menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        menuToggle.innerHTML = open
          ? '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>'
          : '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>';
      };
      const closeMenu = () => {
        mobileNav?.classList.remove('is-open');
        setMenuIcon(false);
      };
      menuToggle?.addEventListener('click', () => {
        const open = mobileNav?.classList.toggle('is-open') ?? false;
        setMenuIcon(open);
      });
      mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      window.addEventListener('resize', () => {
        if (window.innerWidth > 900) closeMenu();
      });
    </script>
    <script>
      import '../scripts/audio-player';
    </script>
  </body>
</html>
