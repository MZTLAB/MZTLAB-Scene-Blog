---
import type { Comment, PostDetail, SiteInfo } from '../types';
import { formatDate } from '../lib/format';
import Icon from './Icon.astro';

interface Props {
  post: PostDetail;
  site: SiteInfo;
  comments: Comment[];
}

const { post, site, comments } = Astro.props;
const settings = site.settings;
const enabled = settings.comments_enabled && post.allow_comments;
const copy = (key: keyof typeof settings, fallback: string) => {
  const value = settings[key];
  return typeof value === 'string' && value.trim() ? value : fallback;
};
---
<section class="comments" id="comments" data-comments data-post-id={post.id} data-enabled={enabled ? 'true' : 'false'}>
  <div class="comments-head">
    <h2>{copy('copy_comments_title', '留言')}</h2>
    <span>{String(comments.length).padStart(2, '0')} RESPONSES</span>
  </div>

  {
    !enabled ? (
      <p class="form-hint" style="padding-top:18px">{copy('copy_comments_closed', '这篇文章的留言已关闭。')}</p>
    ) : (
      <>
        {comments.length ? (
          <div class="comment-list">
            {comments.map((comment) => (
              <article class="comment">
                <div class="comment__who">
                  <strong>{comment.author_name}</strong>
                  <time datetime={comment.created_at}>{formatDate(comment.created_at, 'short')}</time>
                  {comment.author_url && (
                    <a
                      class="text-link"
                      href={comment.author_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      style="font-size:9.5px"
                    >
                      网站
                    </a>
                  )}
                </div>
                <div class="comment__body">{comment.content}</div>
              </article>
            ))}
          </div>
        ) : (
          <p class="form-hint" style="padding-top:18px">{copy('copy_comments_empty', '还没有留言。')} 你可以留下第一句话。</p>
        )}

        <form class="comment-form" data-comment-form novalidate>
          <h3>说点什么</h3>
          <p class="form-hint">
            {post.comment_moderation
              ? '留言会在审核后出现。邮箱只用于识别，不会公开。'
              : '邮箱只用于识别，不会公开。'}
          </p>
          <div class="form-row">
            <div class="field">
              <label for="comment-name">称呼 *</label>
              <input id="comment-name" name="author_name" type="text" maxlength="40" required autocomplete="nickname" />
            </div>
            <div class="field">
              <label for="comment-email">邮箱</label>
              <input id="comment-email" name="author_email" type="email" maxlength="120" autocomplete="email" />
            </div>
          </div>
          <div class="field">
            <label for="comment-url">网站（可选）</label>
            <input id="comment-url" name="author_url" type="url" maxlength="300" placeholder="https://" />
          </div>
          <div class="field">
            <label for="comment-content">留言 *</label>
            <textarea id="comment-content" name="content" rows="5" minlength="2" maxlength="3000" required></textarea>
          </div>
          <div class="honeypot" aria-hidden="true">
            <label for="comment-website">Website</label>
            <input id="comment-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form-actions">
            <span class="comment-status" data-comment-status role="status"></span>
            <button class="btn" type="submit">
              提交留言 <Icon name="arrowRight" size={14} />
            </button>
          </div>
        </form>
      </>
    )
  }
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-comments]');
  const form = section?.querySelector<HTMLFormElement>('[data-comment-form]');
  const status = section?.querySelector<HTMLElement>('[data-comment-status]');
  const postId = section?.dataset.postId;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    if (status) status.textContent = '正在提交…';
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const response = await fetch(`/api/posts/${postId}/comments`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.detail || '提交失败，请稍后再试');
      if (status) status.textContent = result.message || '留言已提交。';
      form.reset();
    } catch (error) {
      if (status) {
        status.textContent = error instanceof Error ? error.message : '提交失败，请稍后再试';
      }
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
