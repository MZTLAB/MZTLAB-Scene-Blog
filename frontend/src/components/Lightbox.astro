---
import Icon from './Icon.astro';
---
<div class="lightbox" id="sceneLightbox" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="图片查看">
  <div class="lightbox__bar">
    <span data-lb-counter>—</span>
    <strong data-lb-title></strong>
    <a class="lightbox__download" data-lb-download hidden href="#" download>
      <Icon name="download" size={14} /> <span>下载原图</span>
    </a>
    <button class="lightbox__btn lightbox__close" type="button" data-lb-close aria-label="关闭">
      <Icon name="close" size={18} />
    </button>
  </div>

  <div class="lightbox__stage">
    <figure class="lightbox__figure">
      <picture>
        <source data-lb-source="avif" type="image/avif" />
        <source data-lb-source="webp" type="image/webp" />
        <img class="lightbox__image" data-lb-image alt="" decoding="async" />
      </picture>
      <figcaption class="lightbox__caption">
        <div class="lightbox__text">
          <strong data-lb-caption></strong>
          <span data-lb-meta></span>
        </div>
        <dl class="lightbox__exif" data-lb-exif aria-label="照片 EXIF"></dl>
      </figcaption>
    </figure>
  </div>

  <div class="lightbox__nav">
    <button class="lightbox__btn" type="button" data-lb-prev aria-label="上一张">
      <Icon name="arrowLeft" size={18} />
    </button>
    <span class="number-label" data-lb-position></span>
    <button class="lightbox__btn" type="button" data-lb-next aria-label="下一张">
      <Icon name="arrowRight" size={18} />
    </button>
  </div>
</div>

<script>
  import '../scripts/lightbox';
</script>
