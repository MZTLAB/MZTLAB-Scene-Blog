---
import Icon from './Icon.astro';
import CoverArt from './CoverArt.astro';
import type { Gallery, SiteInfo } from '../types';
import { exifFieldVisible } from '../lib/photo';
import { formatMonth } from '../lib/format';

interface Props {
  site: SiteInfo;
  featuredGallery: Gallery | null;
}

const { site, featuredGallery } = Astro.props;
const settings = site.settings;
const titleLines = String(settings.hero_title || '光落下。\n场景生成。')
  .split('\n')
  .map((line) => line.trim())
  .filter(Boolean);
const firstLine = titleLines[0] || settings.site_title;
const restLines = titleLines.slice(1);
const style = ['split', 'minimal', 'image'].includes(String(settings.hero_style))
  ? settings.hero_style
  : 'split';
const heroClass =
  style === 'minimal' ? 'hero hero--minimal' : style === 'image' ? 'hero hero--image' : 'hero';
const lead = settings.hero_subtitle || settings.description;
const frame = featuredGallery?.cover || null;
const image = settings.hero_image || frame?.url || '';
const captionMeta = frame
  ? [
      exifFieldVisible(frame, 'camera') ? frame.camera : '',
      exifFieldVisible(frame, 'focal_length') ? frame.focal_length : '',
      exifFieldVisible(frame, 'aperture') ? frame.aperture : '',
      exifFieldVisible(frame, 'exposure') ? frame.exposure : '',
      exifFieldVisible(frame, 'iso') && frame.iso ? `ISO ${frame.iso}` : '',
      exifFieldVisible(frame, 'taken_at') && frame.taken_at ? formatMonth(frame.taken_at) : '',
    ]
      .filter(Boolean)
      .join(' / ')
  : settings.tagline;
const stats = [
  { value: site.photo_count, label: 'FRAMES' },
  { value: site.gallery_count, label: 'ALBUMS' },
  { value: site.post_count, label: 'TEXTS' },
];
const galleryHref = featuredGallery?.url || '/photos';
---
<section class:list={['container', heroClass]} data-hero>
  <div class="hero-copy">
    <div class="hero-code">
      <span class="code-comment">//</span>
      <span>{settings.hero_eyebrow || 'MZTLAB // VISUAL_ARCHIVE'}</span>
      <span class="code-cursor" aria-hidden="true">_</span>
    </div>
    <h1 class="hero-title">
      {firstLine}
      {
        restLines.length > 0 && (
          <>
            <br />
            <em>{restLines.join(' ')}</em>
          </>
        )
      }
    </h1>
    <p class="hero-lead">{lead}</p>
    <div class="hero-actions">
      <a class="btn" href="/photos">
        影像索引
        <Icon name="arrowRight" size={14} />
      </a>
      <a class="text-link" href="/archive">
        文字档案 <Icon name="arrowUpRight" size={13} />
      </a>
    </div>
    <div class="hero-stats">
      {
        stats.map((stat, index) => (
          <>
            {index > 0 && <i class="sep" aria-hidden="true"></i>}
            <span>
              <strong>{String(stat.value).padStart(2, '0')}</strong> {stat.label}
            </span>
          </>
        ))
      }
    </div>
  </div>

  {
    style === 'image' ? (
      image && (
        <div class="hero-figure">
          <img src={image} alt="" loading="eager" decoding="async" fetchpriority="high" />
        </div>
      )
    ) : style === 'split' ? (
      <div class="hero-media">
        <div class="code-window">
          <div class="code-window__bar">
            <span class="code-window__lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>{featuredGallery ? `gallery/${featuredGallery.slug}` : 'gallery/index'}</span>
            <span>READ_ONLY</span>
          </div>
          <a class="hero-media__frame" href={galleryHref} aria-label={featuredGallery?.title || '浏览影像相册'}>
            {image ? (
              <img
                src={image}
                alt={frame?.alt || ''}
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            ) : (
              <CoverArt
                title={settings.tagline || settings.site_title}
                slug="hero"
                category={settings.site_subtitle || 'Scene'}
                label={settings.site_title}
                eager
              />
            )}
            <span class="frame-scan" aria-hidden="true"></span>
            <span class="frame-index" aria-hidden="true">01 / {String(site.photo_count).padStart(2, '0')}</span>
          </a>
          <div class="code-window__foot">
            <span>{frame?.filename?.split('/').pop() || 'SCENE.LOG'}</span>
            <span>{captionMeta || 'NO EXIF'}</span>
          </div>
        </div>
      </div>
    ) : null
  }
</section>
