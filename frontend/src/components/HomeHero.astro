---
import Icon from './Icon.astro';
import CoverArt from './CoverArt.astro';
import SmartImage from './SmartImage.astro';
import type { Gallery, SiteInfo } from '../types';
import { exifFieldVisible } from '../lib/photo';
import { formatMonth } from '../lib/format';
import { copyReader } from '../lib/site';

interface Props {
  site: SiteInfo;
  featuredGallery: Gallery | null;
}

const { site, featuredGallery } = Astro.props;
const siteSettings = site.settings.site;
const appearance = site.settings.appearance;
const copy = copyReader(site.settings);

const defaultTitle = '光落下，\n场景生成。';
const titleLines = String(appearance.hero_title || defaultTitle)
  .split('\n')
  .map((line) => line.trim())
  .filter(Boolean);
const firstLine = titleLines[0] || siteSettings.site_title;
const restLines = titleLines.slice(1);
const style = ['split', 'minimal', 'image'].includes(String(appearance.hero_style))
  ? appearance.hero_style
  : 'split';
const heroClass =
  style === 'minimal' ? 'masthead masthead--minimal' : style === 'image' ? 'masthead masthead--image' : 'masthead';
const lead = appearance.hero_subtitle || siteSettings.description;
const frame = featuredGallery?.cover || null;
const image = appearance.hero_image || frame?.url || '';
const imageInfo = appearance.hero_image
  ? (site.hero_image_info ?? null)
  : (frame?.image ?? null);
const captionMeta = frame
  ? [
      exifFieldVisible(frame, 'camera') ? frame.camera : '',
      exifFieldVisible(frame, 'focal_length') ? frame.focal_length : '',
      exifFieldVisible(frame, 'aperture') ? frame.aperture : '',
      exifFieldVisible(frame, 'exposure') ? frame.exposure : '',
      exifFieldVisible(frame, 'iso') && frame.iso ? `ISO ${frame.iso}` : '',
      exifFieldVisible(frame, 'taken_at') && frame.taken_at ? formatMonth(frame.taken_at) : '',
    ]
      .filter(Boolean)
      .join(' / ')
  : siteSettings.tagline;
const stats = [
  { value: site.photo_count, label: copy('stat_photos', 'PHOTOS'), href: '/photos' },
  { value: site.project_count, label: copy('stat_projects', 'PROJECTS'), href: '/projects' },
  { value: site.post_count, label: copy('stat_texts', 'TEXTS'), href: '/archive' },
];
const galleryHref = featuredGallery?.url || '/photos';
const primaryUrl = copy('hero_primary_url', '/photos');
const secondaryUrl = copy('hero_secondary_url', '/projects');
---
<section class:list={['container', heroClass]} data-hero>
  <div class="masthead__copy">
    <p class="masthead__eyebrow">
      <span class="mark" aria-hidden="true">//</span>
      <span>{appearance.hero_eyebrow || 'MZTLAB // SCENE'}</span>
    </p>
    <h1 class="masthead__title">
      {firstLine}
      {
        restLines.length > 0 && (
          <>
            <br />
            <em>{restLines.join(' ')}</em>
          </>
        )
      }
    </h1>
    <p class="masthead__lead">{lead}</p>
    <div class="masthead__actions">
      <a class="btn" href={primaryUrl}>
        {copy('hero_primary_label', '浏览影像')}
        <Icon name="arrowRight" size={14} />
      </a>
      <a class="text-link" href={secondaryUrl}>
        {copy('hero_secondary_label', '查看项目')} <Icon name="arrowUpRight" size={13} />
      </a>
    </div>
    <div class="masthead__stats">
      {
        stats.map((stat) => (
          <a href={stat.href}>
            <strong>{String(stat.value).padStart(2, '0')}</strong>
            <span>{stat.label}</span>
          </a>
        ))
      }
    </div>
  </div>

  {
    style === 'image' ? (
      image && (
        <div class="masthead__image">
          <SmartImage image={imageInfo} src={image} alt="" scene="hero" eager />
        </div>
      )
    ) : style === 'split' ? (
      <div class="masthead__media">
        <a class="masthead__frame" href={galleryHref} aria-label={featuredGallery?.title || '浏览影像相册'}>
          {image ? (
            <SmartImage
              image={imageInfo}
              src={image}
              alt={frame?.alt || ''}
              scene="hero"
              eager
            />
          ) : (
            <CoverArt
              title={siteSettings.tagline || siteSettings.site_title}
              slug="hero"
              category={siteSettings.site_subtitle || 'Scene'}
              label={siteSettings.site_title}
              eager
            />
          )}
        </a>
        <div class="masthead__caption">
          <span>{featuredGallery?.title || siteSettings.site_title}</span>
          <span>{captionMeta || 'NO EXIF'}</span>
        </div>
      </div>
    ) : null
  }
</section>
