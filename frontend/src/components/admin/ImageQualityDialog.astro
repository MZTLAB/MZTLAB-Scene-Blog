---
/**
 * Per-image AVIF quality dialog, opened from the small「画质」button on media
 * cards and gallery photo rows (same interaction pattern as the EXIF editor).
 *
 * Quality is either automatic (each display scene uses its configured quality)
 * or manual (one explicit value for this image). There is no magic "0" value.
 */
import Icon from '../Icon.astro';
---
<div class="modal-backdrop" data-quality-editor>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="quality-editor-title">
    <form data-quality-form>
      <div class="modal__head">
        <h3 id="quality-editor-title" data-quality-title>图片画质</h3>
        <button type="button" data-close-quality aria-label="关闭"><Icon name="close" size={15} /></button>
      </div>
      <div class="modal__body">
        <div class="quality-dialog">
          <div class="quality-dialog__mode">
            <label class="check-row">
              <input type="checkbox" data-quality-auto />
              <span>自动模式</span>
            </label>
            <p class="hint" data-quality-mode-hint>
              按各场景设置分别编码：缩略 / 网格 / 卡片 / 首屏 / 大图 / 正文 / 全屏。
            </p>
          </div>
          <div class="quality-dialog__value">
            <output data-quality-output>AUTO</output>
            <span>AVIF 质量</span>
          </div>
          <input class="quality-dialog__range" type="range" min="1" max="100" step="1" value="62" data-quality-range />
          <div class="quality-dialog__scale">
            <span>1 · 更省流量</span>
            <span>100 · 最高细节</span>
          </div>
          <div class="quality-dialog__row">
            <label class="a-field">
              <span>手动数值</span>
              <input type="number" min="1" max="100" step="1" value="62" data-quality-number />
            </label>
            <p class="hint">
              关闭自动模式后使用此数值；数值越高文件越大。保存后会在后台重新生成这张图的派生图。
            </p>
          </div>
          <p class="quality-dialog__hint" data-quality-hint></p>
        </div>
      </div>
      <div class="modal__foot">
        <button class="a-btn" type="button" data-quality-regenerate>重新生成派生图</button>
        <div class="toolbar-group">
          <button class="a-btn" type="button" data-close-quality>取消</button>
          <button class="a-btn a-btn--primary" type="submit">保存画质</button>
        </div>
      </div>
    </form>
  </div>
</div>
