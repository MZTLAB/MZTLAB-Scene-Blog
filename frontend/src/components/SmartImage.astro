---
/**
 * Responsive image: AVIF → WebP → JPEG, sized for the surrounding scene.
 *
 * Phase 3: a `<picture>` is only emitted when the backend has generated
 * artifacts (`ready` + artifact tokens). Otherwise the ORIGINAL file is rendered
 * with the payload's intrinsic width/height so there is no layout shift.
 */
import {
  SCENE_SIZES,
  fallbackUrl,
  isReady,
  sceneWidths,
  srcset,
  type ImageInfo,
  type Scene,
} from '../lib/images';

interface Props {
  image?: ImageInfo | null;
  src?: string;
  alt?: string;
  scene?: Scene;
  eager?: boolean;
  sizes?: string;
  class?: string;
  width?: number;
  height?: number;
  draggable?: boolean;
}

const {
  image = null,
  src = '',
  alt = '',
  scene = 'card',
  eager = false,
  sizes,
  class: className = '',
  width,
  height,
  draggable,
} = Astro.props;

const info = image;
const readyImage = isReady(info) ? info : null;
const activeSizes = sizes ?? SCENE_SIZES[scene];
const avifSet = readyImage ? srcset(readyImage, scene, 'avif') : '';
const webpSet = readyImage ? srcset(readyImage, scene, 'webp') : '';
const fallback = readyImage ? fallbackUrl(readyImage, scene) : '';
const usePicture = Boolean(readyImage && (avifSet || webpSet || fallback));
const payloadWidth = info?.width && info.width > 0 ? info.width : undefined;
const payloadHeight = info?.height && info.height > 0 ? info.height : undefined;
const displayWidth = width ?? payloadWidth ?? (info ? sceneWidths(scene, info)[0] : undefined);
const displayHeight =
  height ??
  payloadHeight ??
  (displayWidth && payloadWidth && payloadHeight
    ? Math.max(1, Math.round(displayWidth * (payloadHeight / payloadWidth)))
    : undefined);
const loading = eager ? 'eager' : 'lazy';
const priority = eager ? 'high' : 'auto';
const placeholderColor = info?.placeholder || '';
const placeholderStyle = placeholderColor ? `background-color:${placeholderColor}` : undefined;
---
{usePicture ? (
  <picture>
    {avifSet && <source type="image/avif" srcset={avifSet} sizes={activeSizes} />}
    {webpSet && <source type="image/webp" srcset={webpSet} sizes={activeSizes} />}
    <img
      class={className || undefined}
      src={fallback || src}
      alt={alt}
      width={displayWidth}
      height={displayHeight}
      loading={loading}
      decoding="async"
      fetchpriority={priority}
      draggable={draggable}
      style={placeholderStyle}
    />
  </picture>
) : (
  <img
    class={className || undefined}
    src={src}
    alt={alt}
    width={displayWidth}
    height={displayHeight}
    loading={loading}
    decoding="async"
    fetchpriority={priority}
    draggable={draggable}
    style={placeholderStyle}
  />
)}
