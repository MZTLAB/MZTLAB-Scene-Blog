---
import { coverVariant, initial } from '../lib/format';
import SmartImage from './SmartImage.astro';
import type { ImageInfo } from '../types';

interface Props {
  title: string;
  slug: string;
  category?: string;
  image?: string;
  imageInfo?: ImageInfo | null;
  index?: number;
  eager?: boolean;
  label?: string;
  class?: string;
}

const {
  title,
  slug,
  category = '',
  image = '',
  imageInfo = null,
  index = 0,
  eager = false,
  label = 'MZTLAB',
  class: className = '',
} = Astro.props;

const variant = coverVariant(slug || title);
const no = String(index + 1).padStart(2, '0');
const year = new Date().getFullYear();
---
{
  image ? (
    <div class:list={['cover-art', 'cover-art--image', className]}>
      <SmartImage image={imageInfo} src={image} alt="" scene="card" eager={eager} />
    </div>
  ) : (
    <div class:list={['cover-art', `cover-art--v${variant}`, className]} aria-hidden="true">
      <div class="cover-art-top">
        <span>{category || 'SCENE'}</span>
        <span>{label}</span>
      </div>
      <div class="cover-art-glyph">{initial(title)}</div>
      <div class="cover-art-caption">
        <span>{title}</span>
        <span class="cover-no">{no} / {year}</span>
      </div>
    </div>
  )
}
