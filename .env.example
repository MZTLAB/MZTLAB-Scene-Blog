# ---------------------------------------------------------------------------
# MZTLAB · Mono / Scene  — copy to .env and adjust. All values are optional.
# ---------------------------------------------------------------------------

# Where SQLite and uploaded images live. Relative paths are resolved by
# backend/app/config.py (default: backend/data).
# BLOG_DATA_DIR=./backend/data

# Public address used in canonical URLs, RSS and sitemap. You can also change
# this inside 管理后台 → 设置. No trailing slash.
# BLOG_SITE_URL=http://127.0.0.1:4321

# Address the Astro server uses to reach FastAPI. Keep this on localhost or a
# private Docker network; never expose the API directly to the internet.
# BLOG_API_INTERNAL_URL=http://127.0.0.1:8000

# Session lifetime and cookie security. Set COOKIE_SECURE=true only under HTTPS.
# BLOG_SESSION_DAYS=14
# BLOG_COOKIE_SECURE=false
# BLOG_SESSION_COOKIE=mztlab_session

# Demo content (three galleries with generated images, three articles and the
# About page) is inserted once on first launch. Set false for an empty site;
# you can also delete anything from the admin later.
# BLOG_SEED_DEMO=true

# Maximum upload size in megabytes.
# BLOG_MAX_UPLOAD_MB=12

# Optional first-run administrator. If both are set and the users table is
# empty, this account is created automatically. Otherwise use /admin/setup.
# BLOG_ADMIN_USER=
# BLOG_ADMIN_PASSWORD=
# BLOG_ADMIN_NAME=MZTLAB

# Local ports used by scripts/run.py (not read by the servers themselves).
# BLOG_BACKEND_PORT=8000
# BLOG_FRONTEND_PORT=4321

# Only needed if you call the API from another origin. Leave empty normally.
# BLOG_CORS_ORIGINS=
