# ---------------------------------------------------------------------------
# MZTLAB · Scene 3.0.0 — copy to .env and adjust. All values are optional.
# ---------------------------------------------------------------------------

# Public address used in canonical URLs, RSS, sitemap and Secure-cookie
# detection. No trailing slash. In production this is the site served by the
# operator nginx (https).
# BLOG_SITE_URL=https://your.site

# Where SQLite and uploaded images live. Relative paths are resolved by
# backend/app/config.py (default: backend/data).
# BLOG_DATA_DIR=./backend/data

# Address the Astro server uses for its server-side data fetching. Keep this on
# localhost or a private Docker network; never expose the API directly.
# BLOG_API_INTERNAL_URL=http://127.0.0.1:8000

# Session lifetime. The cookie's Secure flag is derived from BLOG_SITE_URL
# (https -> true); set BLOG_COOKIE_SECURE only to override that.
# BLOG_SESSION_DAYS=7
# BLOG_COOKIE_SECURE=true
# BLOG_SESSION_COOKIE=mztlab_session

# The API trusts X-Forwarded-For / X-Forwarded-Proto only from this peer (the
# operator nginx, or the local dev proxy). Must match the address uvicorn sees.
# BLOG_TRUSTED_PROXY=127.0.0.1

# Expose /api/docs and /api/openapi.json. Keep false in production; the API
# schema is a complete map of the backend.
# BLOG_ENABLE_API_DOCS=false

# Demo content (galleries with generated images, articles and the About page)
# is inserted once on first launch, only when this is explicitly true.
# 3.0.0 initialises an empty database only.
# BLOG_SEED_DEMO=false

# Default maximum upload size in megabytes (first boot only; afterwards edit
# 设置 → 上传与媒体 in the admin, together with the enabled file formats).
# BLOG_MAX_UPLOAD_MB=12

# Administrators ignore the upload policy above; this hard ceiling protects the
# server (memory/disk) and is the only size limit admins are subject to.
# BLOG_ADMIN_MAX_UPLOAD_MB=200

# Optional first-run administrator. If both are set and the users table is
# empty, this account is created automatically. Otherwise use /admin/setup.
# Passwords must be >= 10 chars with at least three character classes; common
# weak passwords are rejected.
# BLOG_ADMIN_USER=
# BLOG_ADMIN_PASSWORD=
# BLOG_ADMIN_NAME=MZTLAB

# Local ports used by scripts/run.py (not read by the servers themselves).
# BLOG_BACKEND_PORT=8000
# BLOG_BACKEND_HOST=127.0.0.1
# BLOG_FRONTEND_PORT=4321

# Only needed if you call the API from another origin. Leave empty normally.
# BLOG_CORS_ORIGINS=

# The rate limiter and settings cache are in process memory, so 3.0.0 refuses
# to start with more than one worker. Leave this at 1.
# WEB_CONCURRENCY=1

# ---------------------------------------------------------------------------
# Image pipeline
# ---------------------------------------------------------------------------
# Every upload keeps its original. AVIF / WebP / JPEG variants are generated
# on demand and pre-warmed after upload. Pipeline parameters (ladder, format
# switches, storage coordinates) live in 管理后台 → 设置 → 图片与存储.
# Encoding quality is a code constant (`PIPELINE_DEFAULTS`).
# BLOG_IMAGE_CACHE_DIR=./backend/data/cache
# BLOG_IMAGE_ENCODE_WORKERS=2

# ---------------------------------------------------------------------------
# Object storage (optional, S3-compatible; Cloudflare R2 is the reference)
# ---------------------------------------------------------------------------
# Non-secret coordinates (endpoint, bucket, prefix, …) are edited in the admin.
# Credentials are read from the environment only and never stored in the
# database (12-factor). BLOG_STORAGE_BACKEND overrides the admin value when set.
# BLOG_STORAGE_BACKEND=s3
# BLOG_S3_ACCESS_KEY=
# BLOG_S3_SECRET_KEY=
# BLOG_S3_PATH_STYLE=false
# Public bucket / CDN domain. When set, generated images are loaded directly
# from it (immutable cache headers); empty means same-origin proxy.
# BLOG_S3_PUBLIC_BASE_URL=
